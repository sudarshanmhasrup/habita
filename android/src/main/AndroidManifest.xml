<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A buzz when a rest between sets ends. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Rings exactly when a rest ends while the phone is locked. Android grants both on install:
         the first from 13 on, the second before. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Bank debit SMS become expenses; the SMS never leave the phone. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Lets a new payment open the app on its record screen from the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- A note for each payment, to pick its category, and the Sunday waist reminder. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sets the Sunday waist reminder again after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Installs updates downloaded from the Habita server; Android asks the user each time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".HabitaApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Habita">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AppStarting"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the camera a file to write a gym photo to, and other apps a photo card to post. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <receiver
            android:name="dev.habita.app.feature.expense.android.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="dev.habita.app.feature.expense.android.CategoryActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
        <receiver
            android:name="dev.habita.app.feature.gym.android.WaistReminderReceiver"
            android:exported="false" />
        <receiver
            android:name="dev.habita.app.feature.gym.android.RestEndReceiver"
            android:exported="false" />
        <receiver
            android:name="dev.habita.app.feature.food.android.RefillReminderReceiver"
            android:exported="false" />
        <receiver
            android:name="dev.habita.app.feature.food.android.RefillSnoozeReceiver"
            android:exported="false" />
        <receiver
            android:name="dev.habita.app.feature.gym.android.ReminderRestoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>