CREATE TABLE warm_up_log (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    status TEXT NOT NULL,
    completed_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    server_seq INTEGER NOT NULL
);

CREATE INDEX warm_up_log_server_seq ON warm_up_log (server_seq);

selectById:
SELECT * FROM warm_up_log WHERE id = ?;

save:
INSERT OR REPLACE INTO warm_up_log VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM warm_up_log ORDER BY completed_at;

-- Up to :limit changes after :since, oldest first.
changedSince:
SELECT * FROM warm_up_log WHERE server_seq > :since ORDER BY server_seq LIMIT :limit;