-- Session tokens, stored only as SHA-256 hashes.
CREATE TABLE auth_token (
    token_hash TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL
);

insert:
INSERT INTO auth_token (token_hash, created_at) VALUES (?, ?);

exists:
SELECT count(*) FROM auth_token WHERE token_hash = ?;

delete:
DELETE FROM auth_token WHERE token_hash = ?;