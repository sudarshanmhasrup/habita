CREATE TABLE exercise_step (
    exercise_id TEXT NOT NULL PRIMARY KEY,
    step INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    server_seq INTEGER NOT NULL
);

CREATE INDEX exercise_step_server_seq ON exercise_step (server_seq);

selectById:
SELECT * FROM exercise_step WHERE exercise_id = ?;

save:
INSERT OR REPLACE INTO exercise_step VALUES (?, ?, ?, ?);

selectAll:
SELECT * FROM exercise_step;

-- Up to :limit changes after :since, oldest first.
changedSince:
SELECT * FROM exercise_step WHERE server_seq > :since ORDER BY server_seq LIMIT :limit;