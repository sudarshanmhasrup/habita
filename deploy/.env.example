# Copy to .env next to compose.yaml, fill in, and run chmod 600 .env.
# Keep the single quotes around the hash: it contains $ signs.

HABITA_DOMAIN=habita.example.com
HABITA_EMAIL=you@example.com
HABITA_PASSWORD_HASH='paste-the-output-of-hash-password-here'

# Optional: the token CI publishes Android updates with (at least 32 characters). Make one with
# openssl rand -hex 32 and store the same value as the HABITA_PUBLISH_TOKEN secret on GitHub.
HABITA_PUBLISH_TOKEN=

# Optional: an rclone remote for off-server backups, for example b2:habita-backups.
HABITA_BACKUP_REMOTE=

# Optional: your own image when running a fork.
# HABITA_IMAGE=ghcr.io/<your-github-user>/habita-server:latest