{$HABITA_DOMAIN} {
	encode zstd gzip

	# Published Android builds are larger than any other request; everything else stays small.
	@publish path /app/android/releases
	@other not path /app/android/releases
	request_body @publish {
		max_size 100MB
	}
	request_body @other {
		max_size 10MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy server:8080
}