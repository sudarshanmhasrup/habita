{$HABITA_DOMAIN} {
	encode zstd gzip

	# Published app builds (Android, Windows, Mac, Linux) are larger than any other request;
	# everything else stays small.
	@publish path /app/android/releases /app/windows/releases /app/mac/releases /app/linux/releases
	@other not path /app/android/releases /app/windows/releases /app/mac/releases /app/linux/releases
	request_body @publish {
		max_size 300MB
	}
	request_body @other {
		max_size 10MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy server:8080
}