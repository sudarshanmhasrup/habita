-- Single values, such as the monthly income from before budgets were per month, and each month's
-- own budget ("budget@2026-11", see MonthBudget). updated_at and dirty drive syncing, as for
-- categories.
CREATE TABLE expense_value (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL,
    updated_at INTEGER NOT NULL DEFAULT 0,
    dirty INTEGER NOT NULL DEFAULT 0
);

select:
SELECT value FROM expense_value WHERE key = ?;

budgets:
SELECT * FROM expense_value WHERE key LIKE 'budget@%';

-- Values whose key starts a certain way, such as orders waiting for their bank SMS ("order@%").
withPrefix:
SELECT * FROM expense_value WHERE key LIKE ? AND value != '';

byKey:
SELECT * FROM expense_value WHERE key = ?;

save:
INSERT OR REPLACE INTO expense_value (key, value, updated_at, dirty) VALUES (?, ?, ?, ?);

selectDirty:
SELECT * FROM expense_value WHERE dirty = 1;

markClean:
UPDATE expense_value SET dirty = 0 WHERE key = ? AND updated_at = ?;

markAllDirty:
UPDATE expense_value SET dirty = 1;