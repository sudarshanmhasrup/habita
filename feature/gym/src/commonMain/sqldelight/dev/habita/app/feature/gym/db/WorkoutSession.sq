-- Local copies of synced records. dirty = 1 marks a change not yet pushed to the server.
CREATE TABLE workout_session (
    id TEXT NOT NULL PRIMARY KEY,
    workout_id TEXT NOT NULL,
    program_version INTEGER NOT NULL,
    started_at INTEGER NOT NULL,
    main_started_at INTEGER,
    ended_at INTEGER,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL,
    dirty INTEGER NOT NULL
);

selectAll:
SELECT * FROM workout_session;

selectById:
SELECT * FROM workout_session WHERE id = ?;

selectDirty:
SELECT * FROM workout_session WHERE dirty = 1;

updatedAt:
SELECT updated_at FROM workout_session WHERE id = ?;

save:
INSERT OR REPLACE INTO workout_session VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

markClean:
UPDATE workout_session SET dirty = 0 WHERE id = ? AND updated_at = ?;